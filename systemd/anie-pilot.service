[Unit]
Description=ANIE 72-Hour Pilot First-Party Intelligence Bounded Batch Collector
Documentation=file:///opt/anie-phase2/docs/REAL_WORLD_PILOT.md
After=network-online.target
Wants=network-online.target
# Fail-Closed Completion Barrier: If the 72-hour pilot completed sentinel exists,
# systemd condition evaluation evaluates to false and skips service startup cleanly.
ConditionPathExists=!/var/lib/anie/pilot_completed.sentinel

[Service]
Type=oneshot
User=anie
Group=anie
WorkingDirectory=/var/lib/anie

# Optional environment configuration for authorization and flags
EnvironmentFile=-/etc/default/anie-pilot
Environment=ANIE_LIVE_COLLECTION_AUTHORIZED=1

# Fail-Closed Security Preflight: ExecStartPre fails the unit (observable failed state)
# if IMDS 169.254.169.254 is reachable, egress filtering is inactive, or preflight checks fail.
ExecStartPre=/opt/anie-phase2/venv/bin/python -m anie preflight --imds-ip 169.254.169.254

# Execute controlled 72-hour pilot collection batch with strict 3-run governor and alternation
ExecStart=/opt/anie-phase2/venv/bin/python -m anie collect-batch \
    --pilot \
    --mode live \
    --quota-db /var/lib/anie/doh_quota.sqlite \
    --store-db /var/lib/anie/real_intelligence.sqlite \
    --log-file /var/log/anie/collector.jsonl \
    --lock-file /var/lib/anie/collector.lock \
    $EXTRA_OPTS

# Strict supervisor timeouts (RuntimeMaxSec does NOT apply to Type=oneshot)
TimeoutStartSec=60s
TimeoutStopSec=15s
KillMode=control-group
Restart=no

# Host resource boundaries (designed for Oracle Cloud 1 GiB micro VM)
MemoryMax=128M
MemoryHigh=96M
CPUQuota=20%
Nice=19

# Security sandbox and filesystem boundaries
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
NoNewPrivileges=yes

# Network egress boundary: IMDS 169.254.169.254 is completely removed.
# Only pinned DoH bootstrap and authoritative anycast IPs are permitted.
IPAddressDeny=any
IPAddressAllow=104.16.248.249 104.16.249.249 2606:4700::6810:f8f9 2606:4700::6810:f9f9 1.1.1.1 1.0.0.1

# Explicit read/write storage access
ReadWritePaths=/var/lib/anie /var/log/anie
ReadOnlyPaths=/opt/anie-phase2

# Journal logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
